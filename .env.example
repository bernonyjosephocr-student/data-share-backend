# JWT
JWT_SECRET_BASE64=REMPLACER_PAR_UNE_CLE_ALEATOIRE
JWT_EXPIRATION_MS=900000

# LOG
CRON_LOG_LEVEL=DEBUG
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
HIBERNATE_LOG_LEVEL=DEBUG
HIBERNATE_BIND_LOG_LEVEL=TRACE

#CLEANIG CRON
CRON_EXPIRED_FILES_CLEANUP="0 */5 * * * *"

# SECURITY
CORS_ALLOWED_ORIGINS=http://localhost:4200